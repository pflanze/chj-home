! 'xrdb .Xresources' for reloading (before Debian it was .Xdefaults)
! (it *does* delete resources that are not in the file anymore [hm. sometimes?])

! 'appres ..' for displaying

! xprop | grep WM_CLASS and click on a window for showing under which
! ids a program *might* read settings, although xemacs for example
! does not show up as xemacs there but still reads the xemacs*
! settings.

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

xpdf.initialZoom: width

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

xemacs*Background: #d3d3dd
xemacs.default.attributeBackground: #f0e8f2
xemacs*borderColor: Red
xemacs*borderWidth: 0
! ^- damit dann kein Rand mehr
xemacs*internalBorderWidth: 1
xemacs.internalBorderColor: Red

! xemacs*Foreground: Whea
! xemacs*pointerColor: Orchid
!              ^- inhaltsfarbe
xemacs*pointerBackground: #e0e0e0
xemacs*cursorColor: Orchid
! xemacs*bitmapIcon: on
! xemacs*font: fixed
xemacs.geometry: 90x43
xemacs.leftToolBarWidth: 30

! menubar
XEmacs*fontSet: -adobe-helvetica-bold-r-normal-*-12-*-*-*-*-*-*-*
XEmacs*menubar*FontSet: -adobe-helvetica-bold-r-normal-*-12-*-*-*-*-*-*-*
! modeline
!XEmacs.modeline.attributeFont: -*-*-*-*-*-*-*-*-*-*-*-*-*-*

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

URxvt.geometry: 110x30
URxvt.scrollTtyOutput: False
URxvt.scrollTtyKeypress: True
URxvt.scrollWithBuffer: True
URxvt.perl-ext: default,-selection
URxvt.perl-ext-common: default,matcher
URxvt.matcher.button: 1
URxvt.matcher.pattern.1: ^(?:[ \\t]*-->[ \\t]+)?([^\\t]+[^\\t:]:\\d+:\\d+)$
URxvt.matcher.launcher.1: rxvt-run g $1


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
xearth.bigstars:	20
xearth.starfreq:	0.001
xearth.twopix:	False

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
ptkdb*scrollbars: sw
!Does not work. See env var instead (s. manpage).




Xpdf.geometry: 1059x900
